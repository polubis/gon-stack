---
import '../style/index.css';
import { CookieConsent } from '@/shared/cookies/presentation/cookie-consent';
import { APP_ROUTER, type PageUrl } from '@/shared/router/routes';

const PRIVACY_POLICY_URL = APP_ROUTER.privacyPolicy();
const COOKIE_CONSENT_PAGES: readonly PageUrl[] = [
  APP_ROUTER.home(),
  APP_ROUTER.signIn(),
  APP_ROUTER.signUp(),
];

type Props = {
  description: string;
  title: string;
  siteName: string;
  domain: string;
  url: PageUrl;
  keywords: string;
  imageUrl: string;
  imageAlt: string;
};

const {
  title,
  description,
  siteName,
  keywords,
  url,
  domain,
  imageUrl,
  imageAlt,
}: Props = Astro.props;

const siteUrl = `${domain}${url}`;
const showCookieConsent = COOKIE_CONSENT_PAGES.includes(url);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head-extra" />
    <script is:inline>
      try {
        if (localStorage.getItem('parka:theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="canonical" href={siteUrl} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b6e46" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <slot />
    {
      showCookieConsent && (
        <CookieConsent client:load privacyPolicyUrl={PRIVACY_POLICY_URL} />
      )
    }
  </body>
</html>
