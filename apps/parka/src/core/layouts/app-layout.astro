---
import { ClientRouter } from 'astro:transitions';
import { AuthGuard } from '@/shared/auth';
import { SyncedAppNav } from '@/shared/navigation/app-nav';
import type { PageUrl } from '@/shared/router';
import Seo from './seo.astro';

type Props = {
  description: string;
  title: string;
  siteName: string;
  domain: string;
  url: PageUrl;
  keywords: string;
  imageUrl: string;
  imageAlt: string;
};

const props: Props = Astro.props;
---

<Seo {...props}>
  <ClientRouter slot="head-extra" />
  <div transition:persist="app-auth-guard">
    <AuthGuard mode="protected" client:only="react" />
  </div>
  <div class="min-h-screen w-full bg-surface lg:flex">
    <div
      transition:persist="app-side-nav"
      class="sticky top-0 z-(--z-nav) hidden h-screen w-64 shrink-0 lg:block xl:w-72"
    >
      <SyncedAppNav placement="side" client:only="react" />
    </div>
    <div class="flex min-h-screen min-w-0 flex-1 flex-col">
      <div class="flex min-h-0 w-full flex-1 flex-col">
        <slot />
      </div>
      <div
        transition:persist="app-bottom-nav"
        class="sticky bottom-0 z-(--z-nav) mt-auto lg:hidden"
      >
        <SyncedAppNav placement="bottom" client:only="react" />
      </div>
    </div>
  </div>
</Seo>
