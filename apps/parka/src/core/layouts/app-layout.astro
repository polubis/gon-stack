---
import { ClientRouter } from 'astro:transitions';
import { AuthGuard } from '@/shared/auth';
import { SyncedAppNav } from '@/shared/navigation/app-nav';
import type { PageUrl } from '@/shared/router';
import Seo from './seo.astro';

type Props = {
  description: string;
  title: string;
  siteName: string;
  domain: string;
  url: PageUrl;
  keywords: string;
  imageUrl: string;
  imageAlt: string;
};

const props: Props = Astro.props;
---

<Seo {...props}>
  <ClientRouter slot="head-extra" />
  <div transition:persist="app-auth-guard">
    <AuthGuard mode="protected" client:only="react" />
  </div>
  <div class="min-h-screen w-full bg-surface">
    <div class="flex min-h-screen w-full flex-col bg-surface">
      <div
        transition:persist="app-top-nav"
        class="sticky top-0 z-(--z-nav) hidden lg:block lg:min-h-14"
      >
        <SyncedAppNav placement="top" client:only="react" />
      </div>
      <div
        class="mx-auto flex min-h-0 w-full max-w-7xl flex-1 flex-col"
      >
        <slot />
      </div>
      <div transition:persist="app-bottom-nav">
        <SyncedAppNav placement="bottom" client:only="react" />
      </div>
    </div>
  </div>
</Seo>
