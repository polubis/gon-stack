---
import { ClientRouter } from 'astro:transitions';
import { SyncedAppNav } from '@/shared/navigation/app-nav';
import type { PageUrl } from '@/shared/router';
import Seo from './seo.astro';

type Props = {
  description: string;
  title: string;
  siteName: string;
  domain: string;
  url: PageUrl;
  keywords: string;
  imageUrl: string;
  imageAlt: string;
};

const props: Props = Astro.props;
---

<Seo {...props}>
  <ClientRouter slot="head-extra" />
  <div class="min-h-screen w-full bg-surface">
    <div
      class="mx-auto flex min-h-screen w-full max-w-md flex-col bg-surface shadow-sm"
    >
      <div class="flex min-h-0 flex-1 flex-col">
        <slot />
      </div>
      <div transition:persist="app-bottom-nav">
        <SyncedAppNav client:only="react" />
      </div>
    </div>
  </div>
</Seo>
