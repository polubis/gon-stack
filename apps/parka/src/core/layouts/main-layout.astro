---
import { PublicNav } from '@/shared/navigation/public-nav/presentation/public-nav';
import type { PageUrl } from '@/shared/router/routes';
import Seo from './seo.astro';

type Props = {
  description: string;
  title: string;
  siteName: string;
  domain: string;
  url: PageUrl;
  keywords: string;
  imageUrl: string;
  imageAlt: string;
};

const props: Props = Astro.props;
---

<Seo {...props}>
  <div class="flex min-h-screen w-full flex-col">
    <div class="sticky top-0 z-(--z-raised) min-h-20 px-4 pt-3 md:px-8">
      <PublicNav client:only="react" />
    </div>
    <slot />
  </div>
</Seo>
