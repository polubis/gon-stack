---
import { PublicNav } from '@/shared/navigation/public-nav';
import type { PageUrl } from '@/shared/router';
import Seo from './seo.astro';

type Props = {
  description: string;
  title: string;
  siteName: string;
  domain: string;
  url: PageUrl;
  keywords: string;
  imageUrl: string;
  imageAlt: string;
};

const props: Props = Astro.props;
---

<Seo {...props}>
  <div class="flex min-h-screen w-full flex-col">
    <div class="min-h-14 border-b border-line bg-card">
      <PublicNav client:only="react" />
    </div>
    <slot />
  </div>
</Seo>
