---
export const prerender = true;

import MainLayout from '@/core/layouts/main-layout.astro';
import { Main } from '@/modules/limits';
import { APP_ROUTER } from '@/shared/router';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={APP_ROUTER.limits()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Limity i cele | Parka"
  description="Limity wydatków i cele oszczędnościowe."
>
  <Main client:load  />
</MainLayout>
