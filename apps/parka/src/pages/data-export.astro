---
export const prerender = true;

import MainLayout from '@/core/layouts/main-layout.astro';
import { DataExportMain } from '@/modules/info';
import { routes } from '@/shared/router';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={routes.dataExport()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Eksport danych | Parka"
  description="Pobierz swoje dane w CSV lub PDF."
>
  <DataExportMain client:load  />
</MainLayout>
