---
export const prerender = true;

import MainLayout from '@/core/layouts/main-layout.astro';
import { AiInfoMain } from '@/modules/info';
import { APP_ROUTER } from '@/shared/router';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={APP_ROUTER.aiInfo()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="AI — jak to działa | Parka"
  description="Transparentne wyjaśnienie działania AI."
>
  <AiInfoMain client:load  />
</MainLayout>
