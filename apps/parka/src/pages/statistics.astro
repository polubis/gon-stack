---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main } from '@/modules/statistics';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url="/statistics/"
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Statystyki | Parka"
  description="Statystyki i porównania wydatków."
>
  <Main client:load  />
</MainLayout>
