---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main } from '@/modules/settings';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url="/settings/"
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Ustawienia | Parka"
  description="Konto, powiadomienia i prywatność."
>
  <Main client:load  />
</MainLayout>
