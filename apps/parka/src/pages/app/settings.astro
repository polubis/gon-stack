---
export const prerender = true;

import AppLayout from '@/core/layouts/app-layout.astro';
import { Main } from '@/modules/settings';
import { APP_ROUTER } from '@/shared/router';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<AppLayout
  siteName="Parka"
  url={APP_ROUTER.settings()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Ustawienia | Parka"
  description="Konto, powiadomienia i prywatność."
>
  <Main client:only="react" />
</AppLayout>
