---
export const prerender = true;

import AppLayout from '@/core/layouts/app-layout.astro';
import { Main } from '@/modules/privacy';
import { APP_ROUTER } from '@/shared/router';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<AppLayout
  siteName="Parka"
  url={APP_ROUTER.privacy()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="RODO i prywatność | Parka"
  description="Jak Parka chroni Twoje dane."
>
  <Main client:only="react" />
</AppLayout>
