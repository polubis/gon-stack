---
export const prerender = true;

import MainLayout from '@/core/layouts/main-layout.astro';
import { Main } from '@/modules/sign-in/presentation/main';
import { AuthGuard } from '@/shared/auth/guard';
import { APP_ROUTER } from '@/shared/router/routes';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={APP_ROUTER.signIn()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, logowanie, rejestracja"
  title="Logowanie | Parka"
  description="Dostęp do Twojego konta Parka."
>
  <AuthGuard mode="guest" client:only="react" />
  <Main client:load />
</MainLayout>
