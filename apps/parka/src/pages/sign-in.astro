---
export const prerender = false;

import MainLayout from '@/core/layouts/main-layout.astro';
import { Main } from '@/modules/sign-in';
import { supabaseServer } from '@/shared/data-sources/supabase-server';
import { routes } from '@/shared/router';

const db = supabaseServer({
  request: Astro.request,
  cookies: Astro.cookies,
});
const { data } = await db.auth.getUser();

if (data.user) return Astro.redirect(routes.dashboard());

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={routes.signIn()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, logowanie, rejestracja"
  title="Logowanie | Parka"
  description="Dostęp do Twojego konta Parka."
>
  <Main client:load />
</MainLayout>
