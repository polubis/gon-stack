---
export const prerender = true;

import MainLayout from '@/core/layouts/main-layout.astro';
import { RedirectAuthenticated } from '@/shared/auth/presentation/redirect-authenticated';
import { Main } from '@/modules/sign-up/presentation/main';
import { APP_ROUTER } from '@/shared/router/routes';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={APP_ROUTER.signUp()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, logowanie, rejestracja"
  title="Rejestracja | Parka"
  description="Dostęp do Twojego konta Parka."
>
  <RedirectAuthenticated client:only="react" />
  <Main client:load />
</MainLayout>
