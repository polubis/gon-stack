---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main } from '@/modules/auth';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url="/sign-up/"
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, logowanie, rejestracja"
  title="Rejestracja | Parka"
  description="Dostęp do Twojego konta Parka."
>
  <Main client:load mode="sign-up" />
</MainLayout>
