---
export const prerender = true;

import AppLayout from '@/core/layouts/app-layout.astro';
import { Main } from '@/modules/dashboard';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<AppLayout
  siteName="Parka"
  url="/dashboard/"
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Podsumowanie | Parka"
  description="Twoje wydatki w wybranym miesiącu."
>
  <Main client:only="react" />
</AppLayout>
