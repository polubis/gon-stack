---
export const prerender = true;

import MainLayout from '@/core/layouts/main-layout.astro';
import { APP_ROUTER } from '@/shared/router/routes';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={APP_ROUTER.privacyPolicy()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, polityka prywatności, rodo, gdpr"
  title="Polityka prywatności | Parka"
  description="Polityka prywatności aplikacji Parka."
>
  <main
    data-e2e="privacy:main"
    class="mx-auto flex flex-1 w-full max-w-2xl flex-col gap-4 px-6 py-10 md:gap-5 md:px-8 md:py-16 lg:py-20"
  >
    <a href={APP_ROUTER.settings()} class="text-sm font-semibold text-brand-dark underline">← Wróć</a>
    <h1 class="text-2xl font-semibold tracking-tight md:text-4xl">Polityka prywatności</h1>
    <p class="text-sm text-ink-soft md:text-base md:leading-relaxed">
      Parka przetwarza dane finansowe wyłącznie w celu świadczenia usługi zarządzania
      wydatkami. Dane są przechowywane na serwerach w Unii Europejskiej oraz szyfrowane
      w spoczynku i podczas przesyłania.
    </p>
    <h2 class="text-lg font-semibold md:mt-2 md:text-xl">Zakres danych</h2>
    <p class="text-sm text-ink-soft md:text-base md:leading-relaxed">
      Adres e-mail, dane paragonów, kategorie, limity i cele oszczędnościowe. Zdjęcia
      paragonów są analizowane przez AI wyłącznie w celu ekstrakcji pozycji i kategorii.
    </p>
    <h2 class="text-lg font-semibold md:mt-2 md:text-xl">Twoje prawa (RODO / GDPR)</h2>
    <p class="text-sm text-ink-soft md:text-base md:leading-relaxed">
      Masz prawo dostępu, sprostowania, przenoszenia i usunięcia danych. Eksport danych
      dostępny jest w formacie CSV oraz PDF w sekcji „Eksport danych”.
    </p>
    <h2 class="text-lg font-semibold md:mt-2 md:text-xl">Pliki cookie</h2>
    <p class="text-sm text-ink-soft md:text-base md:leading-relaxed">
      Śledzenie i analityka są uruchamiane dopiero po wyrażeniu zgody na pliki cookie.
    </p>
  </main>
</MainLayout>
