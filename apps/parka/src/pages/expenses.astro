---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main } from '@/modules/expenses';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url="/expenses/"
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Wydatki | Parka"
  description="Przeglądaj i filtruj swoje wydatki."
>
  <Main client:load  />
</MainLayout>
