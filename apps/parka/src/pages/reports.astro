---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main } from '@/modules/reports';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url="/reports/"
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Raport | Parka"
  description="Miesięczny raport wydatków."
>
  <Main client:load  />
</MainLayout>
