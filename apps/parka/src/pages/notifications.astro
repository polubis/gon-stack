---
export const prerender = true;

import MainLayout from '@/core/layouts/main-layout.astro';
import { Main } from '@/modules/notifications';
import { routes } from '@/shared/router';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Parka"
  url={routes.notifications()}
  imageAlt="Parka"
  domain={domain}
  imageUrl={imageUrl}
  keywords="parka, budżet, wydatki, finanse osobiste"
  title="Powiadomienia | Parka"
  description="Alerty o limitach i paragonach."
>
  <Main client:load  />
</MainLayout>
