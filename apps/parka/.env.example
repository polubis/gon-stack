# Local Supabase (from `pnpm db:start`). Both keys are safe to expose to the client.
PUBLIC_PARKA_SUPABASE_URL=http://localhost:54321
PUBLIC_PARKA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjHxg_3BJgxAaH

# Receipt analysis (OpenCode Zen). Server-only secret.
PARKA_AI_API_KEY=

# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys --json
# Public key is safe for the client; the private key is a server-only secret.
PUBLIC_PARKA_VAPID_PUBLIC_KEY=
PARKA_VAPID_PRIVATE_KEY=
PARKA_VAPID_SUBJECT=mailto:you@example.com
