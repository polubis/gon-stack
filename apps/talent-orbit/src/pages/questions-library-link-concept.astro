---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { LinkConceptMain as Module } from '@/modules/questions-library';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/questions-library-link-concept/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, link concept, questions library, hiring"
  title="Link concept | Talent Orbit"
  description="Select the concept this question will assess."
>
  <Module client:load />
</MainLayout>
