---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { SubmittedMain as Module } from '@/modules/exam';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/exams-submitted/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, attempt submitted, exams, hiring"
  title="Attempt submitted | Talent Orbit"
  description="This attempt is now closed."
>
  <Module client:load />
</MainLayout>
