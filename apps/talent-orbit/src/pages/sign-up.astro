---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main as Module } from '@/modules/sign-up';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/sign-up/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, sign up, register, recruitment"
  title="Sign up | Talent Orbit"
  description="Create your Talent Orbit account."
>
  <Module client:load />
</MainLayout>
