---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ChooseTypeMain as Module } from '@/modules/questions-library';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/questions-library-choose-type/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, choose question type, questions library, hiring"
  title="Choose type | Talent Orbit"
  description="Select the type of question you want to create."
>
  <Module client:load />
</MainLayout>
