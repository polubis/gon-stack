---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main as Module } from '@/modules/dashboard';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/dashboard/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, recruitment, careers, hiring, candidate dashboard"
  title="Dashboard | Talent Orbit"
  description="Your Talent Orbit candidate dashboard."
>
  <Module client:load />
</MainLayout>
