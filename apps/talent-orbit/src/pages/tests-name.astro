---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { NameMain as Module } from '@/modules/tests';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/tests-name/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, name test, tests library, hiring"
  title="Name test | Talent Orbit"
  description="Provide a name and description for your test."
>
  <Module client:load />
</MainLayout>
