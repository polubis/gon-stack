---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ConceptDetailsMain as Module } from '@/modules/concept-details';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/knowledge-bank-concept-detail/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, concept details, knowledge bank, hiring"
  title="State Management | Talent Orbit"
  description="View concept details, parent path, children, metadata, and edit the concept."
>
  <Module client:load />
</MainLayout>
