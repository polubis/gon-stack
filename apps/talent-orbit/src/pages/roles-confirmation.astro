---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ConfirmationMain as Module } from '@/modules/roles';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/roles-confirmation/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, role updated, users, hiring"
  title="Role updated | Talent Orbit"
  description="Confirmation that the user's role has been updated."
>
  <Module client:load />
</MainLayout>
