---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ListMain as Module } from '@/modules/questions-library';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/questions-library/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, questions library, assessments, hiring"
  title="Questions library | Talent Orbit"
  description="Create and manage high-quality questions."
>
  <Module client:load />
</MainLayout>
