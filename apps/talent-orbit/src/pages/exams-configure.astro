---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ConfigureMain as Module } from '@/modules/exam';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/exams-configure/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, configure exam, exams, hiring"
  title="Configure exam | Talent Orbit"
  description="Set the details for your exam."
>
  <Module client:load />
</MainLayout>
