---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ListMain as Module } from '@/modules/roles';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/roles/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, users, roles, hiring"
  title="Users | Talent Orbit"
  description="Manage users and their platform roles."
>
  <Module client:load />
</MainLayout>
