---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { FeedbackMain as Module } from '@/modules/notes-report';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/notes-report-feedback/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, candidate feedback, exams, hiring"
  title="Candidate feedback | Talent Orbit"
  description="Review and share this feedback with the candidate."
>
  <Module client:load />
</MainLayout>
