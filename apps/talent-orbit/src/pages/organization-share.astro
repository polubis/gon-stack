---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ShareMain as Module } from '@/modules/organization';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/organization-share/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, share resource, organization, hiring"
  title="Share resource | Talent Orbit"
  description="Select the resource type, choose the resource, organization, and share."
>
  <Module client:load />
</MainLayout>
