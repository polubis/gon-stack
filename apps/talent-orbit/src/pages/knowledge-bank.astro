---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ListMain as Module } from '@/modules/knowledge-bank';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/knowledge-bank/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, knowledge bank, hiring, concepts"
  title="Knowledge Banks | Talent Orbit"
  description="Curated knowledge for better hiring."
>
  <Module client:load />
</MainLayout>
