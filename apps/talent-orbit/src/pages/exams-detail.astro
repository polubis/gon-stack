---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { DetailMain as Module } from '@/modules/exam';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/exams-detail/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, exam details, exams, hiring"
  title="Exam details | Talent Orbit"
  description="View exam overview, status, and share credentials."
>
  <Module client:load />
</MainLayout>
