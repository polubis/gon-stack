---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { QuestionMain as Module } from '@/modules/exam';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/exams-question/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, take exam, exams, hiring"
  title="Take exam | Talent Orbit"
  description="Answer each question within the time limit and submit your response."
>
  <Module client:load />
</MainLayout>
