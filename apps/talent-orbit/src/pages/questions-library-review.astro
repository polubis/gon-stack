---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ReviewMain as Module } from '@/modules/questions-library';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/questions-library-review/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, review question, questions library, hiring"
  title="Review question | Talent Orbit"
  description="Review the question, options, and correct answer."
>
  <Module client:load />
</MainLayout>
