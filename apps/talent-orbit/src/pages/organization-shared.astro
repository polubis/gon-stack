---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { SharedMain as Module } from '@/modules/organization';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/organization-shared/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, shared resources, organization, hiring"
  title="Shared resources | Talent Orbit"
  description="Browse knowledge banks, questions, and tests shared with your organization."
>
  <Module client:load />
</MainLayout>
