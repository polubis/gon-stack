---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { TranscriptMain as Module } from '@/modules/notes-report';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/notes-report-transcript/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, interview transcript, exams, hiring"
  title="Add transcript | Talent Orbit"
  description="Paste or upload the interview transcript."
>
  <Module client:load />
</MainLayout>
