---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { ListMain as Module } from '@/modules/organization';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/organization/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, organizations, hiring, teams"
  title="Organizations | Talent Orbit"
  description="View and explore organizations you own or participate in."
>
  <Module client:load />
</MainLayout>
