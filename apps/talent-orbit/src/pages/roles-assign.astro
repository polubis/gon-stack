---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { AssignMain as Module } from '@/modules/roles';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Talent Orbit"
  url="/roles-assign/"
  imageAlt="Talent Orbit"
  domain={domain}
  imageUrl={imageUrl}
  keywords="talent orbit, assign role, users, hiring"
  title="Assign role | Talent Orbit"
  description="Assign a platform role to this user."
>
  <Module client:load />
</MainLayout>
