---
export const prerender = true;

import MainLayout from '@/core/layouts/main.astro';
import { Main as Module } from '@/modules/home';

const domain = Astro.locals.siteDomain;
const imageUrl = `${domain}/og.svg`;
---

<MainLayout
  siteName="Cebool"
  url="/"
  imageAlt="Cebool"
  domain={domain}
  imageUrl={imageUrl}
  keywords="cebool"
  title="Home | Cebool"
  description="Cebool."
>
  <Module client:load />
</MainLayout>
