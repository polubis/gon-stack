---
import {
  ArrowRight,
  Building2,
  Calendar,
  ChevronDown,
  HeartPulse,
  Sparkles,
  User,
  type LucideIcon,
} from 'lucide-react';

import { copy } from './copy';
import { BOOKING_URL } from './links';

type OfferTab = 'private' | 'company';

type OfferServiceVariant = {
  id: string;
  name: string;
  price: string;
  duration: string;
};

type OfferServiceContent = {
  id: string;
  title: string;
  description: string;
  price: string;
  body?: string[];
  variants?: OfferServiceVariant[];
  details?: string[];
  videoUrl?: string;
  videoTitle?: string;
};

type OfferService = OfferServiceContent & { icon: LucideIcon };

const privateServiceIcons: Record<string, LucideIcon> = {
  'therapeutic-massage': HeartPulse,
  'classic-massage': Sparkles,
};

const companyServiceIcons: Record<string, LucideIcon> = {
  'office-massage': Building2,
};

const tabIcons: Record<OfferTab, LucideIcon> = {
  private: User,
  company: Building2,
};

const privateServices: OfferService[] = copy.offerWidget.privateServices.map(
  (service) => ({ ...service, icon: privateServiceIcons[service.id] }),
);

const companyServices: OfferService[] = copy.offerWidget.companyServices.map(
  (service) => ({ ...service, icon: companyServiceIcons[service.id] }),
);

const servicesByTab: Record<OfferTab, OfferService[]> = {
  private: privateServices,
  company: companyServices,
};

const defaultOpenServiceId = privateServices[0]?.id ?? null;
---

<section id="oferta" class="scroll-mt-28 bg-surface py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div
      class="grid grid-cols-1 items-start gap-8 md:mx-auto md:max-w-2xl lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:gap-10"
    >
      <div class="w-full lg:max-w-lg">
        <p class="text-xs font-bold tracking-[0.2em] text-primary">
          {copy.offerPanel.eyebrow}
        </p>
        <h2 class="mt-3 font-display text-2xl font-bold leading-tight text-secondary sm:text-3xl">
          {copy.offerPanel.heading}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-light">
          {copy.offerPanel.subheading}
        </p>

        <a
          href={BOOKING_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-bold tracking-wide text-white sm:w-auto"
        >
          <Calendar className="h-4 w-4 shrink-0" />
          {copy.offerPanel.ctaPrimary}
        </a>

        <a
          href={BOOKING_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary"
        >
          {copy.offerPanel.ctaSecondary}
          <ArrowRight className="h-4 w-4 shrink-0" />
        </a>

        <div class="mt-8">
          <div class="rounded-2xl bg-white p-5 ring-1 ring-line sm:p-6">
            <h3 class="text-xs font-bold tracking-wide text-ink-light uppercase">
              {copy.offerPanel.openingHours.title}
            </h3>
            <ul class="mt-5 divide-y divide-line">
              {
                copy.offerPanel.openingHours.days.map((day) => (
                  <li class="flex items-start justify-between gap-4 py-3 first:pt-0 last:pb-0">
                    <span class="text-sm font-medium text-secondary">
                      {day.label}
                    </span>
                    <div class="space-y-0.5 text-right text-sm text-ink-light">
                      {day.closed ? (
                        <span>{copy.offerPanel.openingHours.closedLabel}</span>
                      ) : (
                        day.slots.map((slot) => <span class="block">{slot}</span>)
                      )}
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div
        id="cennik"
        class="scroll-mt-28 overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-line"
      >
        <div class="border-b border-line p-3 sm:p-4">
          <div
            role="tablist"
            aria-label={copy.offerWidget.ariaTablist}
            class="flex flex-col gap-2 sm:flex-row"
          >
            {
              copy.offerWidget.tabs.map(({ id: tabId, label }) => {
                const isActive = tabId === 'private';
                const TabIcon = tabIcons[tabId as OfferTab];

                return (
                  <button
                    type="button"
                    id={`offer-tab-${tabId}`}
                    data-tab={tabId}
                    role="tab"
                    aria-selected={isActive}
                    aria-controls="offer-tabpanel"
                    class={`js-offer-tab flex flex-1 items-center justify-center gap-2 rounded-xl px-4 py-3 text-xs font-bold tracking-wide sm:text-2xs ${
                      isActive
                        ? 'bg-primary text-white'
                        : 'border border-line bg-white text-primary'
                    }`}
                  >
                    <TabIcon className="h-4 w-4 shrink-0" aria-hidden="true" />
                    <span class="uppercase">{label}</span>
                  </button>
                );
              })
            }
          </div>
        </div>

        <div
          id="offer-tabpanel"
          role="tabpanel"
          aria-labelledby="offer-tab-private"
          tabindex="0"
        >
          {
            (Object.keys(servicesByTab) as OfferTab[]).map((tab) => (
              <div
                class="js-offer-services"
                data-tab={tab}
                hidden={tab !== 'private'}
              >
                {
                  servicesByTab[tab].map((service) => {
                    const Icon = service.icon;
                    const isOpen =
                      tab === 'private' && service.id === defaultOpenServiceId;

                    return (
                      <div
                        class="js-offer-service border-b border-line last:border-b-0"
                        data-service-id={service.id}
                      >
                        <button
                          type="button"
                          class="js-offer-toggle flex w-full items-start gap-3 px-4 py-4 text-left sm:gap-4 sm:px-5"
                          aria-expanded={isOpen}
                          aria-label={`${
                            isOpen
                              ? copy.offerWidget.ariaCollapsePrefix
                              : copy.offerWidget.ariaExpandPrefix
                          } ${service.title}`}
                          data-expand-label={`${copy.offerWidget.ariaExpandPrefix} ${service.title}`}
                          data-collapse-label={`${copy.offerWidget.ariaCollapsePrefix} ${service.title}`}
                        >
                          <span
                            class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary"
                            aria-hidden="true"
                          >
                            <Icon className="h-5 w-5 shrink-0" />
                          </span>

                          <span class="min-w-0 flex-1">
                            <span class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
                              <span>
                                <span class="block font-semibold text-secondary">
                                  {service.title}
                                </span>
                                <span class="mt-1 block text-sm leading-relaxed text-ink-light">
                                  {service.description}
                                </span>
                              </span>
                              <span class="shrink-0 text-sm font-semibold text-secondary sm:text-right">
                                {service.price}
                              </span>
                            </span>
                          </span>

                          <ChevronDown
                            className={`js-offer-chevron mt-1 h-5 w-5 shrink-0 text-ink-light transition-transform duration-200${isOpen ? ' rotate-180' : ''}`}
                            aria-hidden="true"
                          />
                        </button>

                        <div
                          class="js-offer-body border-t border-line bg-surface/60 pb-4 pt-3"
                          hidden={!isOpen}
                        >
                          <div class="flex gap-3 px-4 sm:gap-4 sm:px-5">
                            <span class="w-10 shrink-0" aria-hidden="true" />
                            <div class="min-w-0 flex-1 space-y-4">
                              {service.body && service.body.length > 0 && (
                                <div class="space-y-3">
                                  {service.body.map((paragraph) => (
                                    <p class="text-sm leading-relaxed text-ink-light">
                                      {paragraph}
                                    </p>
                                  ))}
                                </div>
                              )}

                              {service.variants && service.variants.length > 0 && (
                                <ul class="divide-y divide-line">
                                  {service.variants.map(
                                    ({ name, price, duration }) => (
                                      <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 py-3 first:pt-0 last:pb-0">
                                        <span class="text-sm leading-snug text-secondary">
                                          {name}
                                        </span>
                                        <span class="text-right text-sm whitespace-nowrap">
                                          <span class="block font-semibold text-secondary">
                                            {price}
                                          </span>
                                          <span class="text-ink-light">
                                            {duration}
                                          </span>
                                        </span>
                                      </li>
                                    ),
                                  )}
                                </ul>
                              )}

                              {service.videoUrl && (
                                <div class="-ml-[calc(2.5rem+0.75rem)] w-[calc(100%+3.25rem)] overflow-hidden rounded-xl ring-1 ring-line sm:-ml-[calc(2.5rem+1rem)] sm:w-[calc(100%+3.5rem)]">
                                  <div class="relative aspect-video">
                                    <iframe
                                      class="absolute inset-0 h-full w-full"
                                      src={service.videoUrl}
                                      title={service.videoTitle ?? service.title}
                                      loading="lazy"
                                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                      allowfullscreen
                                    />
                                  </div>
                                </div>
                              )}

                              {service.details && service.details.length > 0 && (
                                <ul class="space-y-2">
                                  {service.details.map((detail) => (
                                    <li class="flex items-start gap-2 text-sm text-ink-light">
                                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-primary" />
                                      {detail}
                                    </li>
                                  ))}
                                </ul>
                              )}

                              <div class="flex justify-end">
                                <a
                                  href={BOOKING_URL}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-xs font-bold tracking-wide text-white"
                                >
                                  <Calendar
                                    className="h-3.5 w-3.5 shrink-0"
                                    aria-hidden="true"
                                  />
                                  {copy.offerWidget.ctaBook}
                                </a>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            ))
          }

          <div class="border-t border-line px-4 py-4 sm:px-5">
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-primary"
            >
              {copy.offerWidget.ctaAllServices}
              <ArrowRight className="h-4 w-4 shrink-0" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const setServiceOpen = (row: HTMLElement, isOpen: boolean) => {
    const toggle = row.querySelector<HTMLButtonElement>('.js-offer-toggle');
    const body = row.querySelector<HTMLElement>('.js-offer-body');
    const chevron = row.querySelector<HTMLElement>('.js-offer-chevron');
    if (!toggle || !body) return;

    body.hidden = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute(
      'aria-label',
      (isOpen ? toggle.dataset.collapseLabel : toggle.dataset.expandLabel) ??
        '',
    );
    chevron?.classList.toggle('rotate-180', isOpen);
  };

  const openFirstService = (panel: HTMLElement) => {
    panel
      .querySelectorAll<HTMLElement>('.js-offer-service')
      .forEach((row, index) => setServiceOpen(row, index === 0));
  };

  document
    .querySelectorAll<HTMLElement>('.js-offer-service')
    .forEach((row) => {
      const toggle = row.querySelector<HTMLButtonElement>('.js-offer-toggle');
      const body = row.querySelector<HTMLElement>('.js-offer-body');

      toggle?.addEventListener('click', () => {
        setServiceOpen(row, body ? !!body.hidden : true);
      });
    });

  const tabButtons = document.querySelectorAll<HTMLButtonElement>(
    '.js-offer-tab',
  );
  const panels = document.querySelectorAll<HTMLElement>('.js-offer-services');
  const tabpanel = document.getElementById('offer-tabpanel');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tab = button.dataset.tab;
      if (!tab) return;

      tabButtons.forEach((btn) => {
        const isActive = btn === button;
        btn.setAttribute('aria-selected', String(isActive));
        btn.classList.toggle('bg-primary', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('border', !isActive);
        btn.classList.toggle('border-line', !isActive);
        btn.classList.toggle('bg-white', !isActive);
        btn.classList.toggle('text-primary', !isActive);
      });

      panels.forEach((panel) => {
        const isActive = panel.dataset.tab === tab;
        panel.hidden = !isActive;
        if (isActive) openFirstService(panel);
      });

      tabpanel?.setAttribute('aria-labelledby', `offer-tab-${tab}`);
    });
  });
</script>
