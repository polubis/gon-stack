---
import { copy } from './copy';
---

<div class="flex items-center justify-between text-ink-light">
  <span>‹</span>
  <span>{copy.onlineBookingCta.miniCalendarMonth}</span>
  <span>›</span>
</div>
<div class="mt-2 grid grid-cols-7 gap-1 text-center text-ink-light">
  {
    Array.from({ length: 14 }).map((_, i) => (
      <span class={`rounded py-0.5${i === 5 ? ' bg-primary text-white' : ''}`}>
        {i + 3}
      </span>
    ))
  }
</div>
