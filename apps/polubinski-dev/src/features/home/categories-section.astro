---
import { appConfig } from "@/core/config";
---

<section
  class="fluid page-section flex flex-col justify-center items-center text-center"
  aria-labelledby="progress-title"
  id={appConfig.specializationsSection.id}
>
  <h2 id="progress-title" class="text-h2 font-500 max-w-xl">
    Stoisz w miejscu i nie wiesz, jak zrobić kolejny krok?
  </h2>
  <p class="text-regular font-300 mt-8 mb-13">
    Pomogę Ci rozwinąć umiejętności i poszerzyć wiedzę w wielu dziedzinach IT.
  </p>
  <div class="relative">
    <div
      class="absolute bg-[rgba(21,214,131,0.08)] blur-3xl w-full h-full"
      aria-hidden="true"
    >
    </div>
    <ul
      aria-label="Kategorie specjalizacji"
      class="flex flex-wrap justify-center gap-6 max-w-[600px] relative"
    >
      <li
        class="before:animate-fade-in-out before:delay-[4s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Frontend
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[11s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Backend
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[22s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        AI
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[13s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Software Development
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[5s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Soft Skills
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[2s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Fullstack
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[15s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        DevOps
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[30s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Q&A
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[2s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Bazy danych
      </li>
      <li
        class="before:animate-fade-in-out before:delay-[4s] before:opacity-0 text-regular-bold font-500 px-4 py-2 rounded-xl relative border border-[#212923] bg-black/2 before:absolute before:top-[-1px] before:mx-auto before:left-0 before:right-0 before:w-6 before:h-[1px] before:bg-gradient-to-r before:from-[#373838] before:via-[#0CC776] before:to-[#383838]"
      >
        Algorytmy i struktury danych
      </li>
    </ul>
  </div>

  <div class="flex justify-center mt-12">
    <a
      class="flex items-center gap-2 px-6 py-3 bg-primary-500 text-[#091610] rounded-full text-regular-bold font-500 shadow-[0_0_16px_2px_rgba(1,120,70,0.6)] hover:shadow-[0_0_20px_4px_rgba(1,120,70,0.8)] transition-shadow"
      href={appConfig.specializationsSection.technologiesLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Zobacz pełną listę technologii i obszarów wsparcia"
      title="Zobacz pełną listę technologii i obszarów wsparcia"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="text-[#091610]"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
      <span>Sprawdź moją wiedzę</span>
    </a>
  </div>
</section>
