{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/uih/button": ["../../packages/uih/src/button/button.tsx"],
      "@repo/uih/select": ["../../packages/uih/src/select/select.tsx"],
      "@repo/uih/select-stream": [
        "../../packages/uih/src/select/select-stream.ts"
      ]
    }
  }
}
