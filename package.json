{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "skills:update": "pnpm dlx skills update -y",
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "pw:install": "playwright install --with-deps chromium",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:e2e:ui": "turbo run test:e2e:ui",
    "test:e2e:headed": "turbo run test:e2e:headed",
    "test:e2e:report": "turbo run test:e2e:report",
    "test:e2e:update-snapshots": "turbo run test:e2e:update-snapshots --concurrency=1",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,css,js,jsx}\"",
    "format:check": "prettier --check --end-of-line auto \"**/*.{ts,tsx,json,yaml,css,js,jsx}\"",
    "ci:verify": "pnpm ci:security && pnpm hash:check && pnpm log:check && turbo run format:check lint check-types test build --ui=stream && turbo run test:e2e --concurrency=1 --ui=stream",
    "ci:verify:dry": "pnpm ci:security && pnpm hash:check && pnpm log:check && turbo run format:check lint check-types test build --cache=local:,remote: --ui=stream && turbo run test:e2e --cache=local:,remote: --concurrency=1 --ui=stream",
    "ci:e2e": "turbo run test:e2e --concurrency=1",
    "prepare": "husky",
    "check-deps": "ncu --workspaces",
    "update-deps": "ncu -u --workspaces",
    "update-deps-safe": "ncu -u --workspaces --target minor",
    "update-deps-i": "ncu -i --workspaces",
    "ci:format": "lint-staged",
    "ci:check-updates": "pnpm check-deps",
    "ci:security": "pnpm deps:audit && pnpm deps:outdated",
    "deps:audit": "pnpm audit --audit-level low",
    "deps:outdated": "ncu --workspaces --root --target minor --errorLevel 2",
    "db:start": "turbo run db:start",
    "db:stop": "turbo run db:stop",
    "db:gen-types": "turbo run db:gen-types",
    "db:reset": "turbo run db:reset",
    "log:check": "node scripts/log-check.mjs",
    "hash:build": "pnpm --filter @repo/hashy build",
    "hash:check": "pnpm hash:build && node packages/hashy/dist/cli.js --manifest hashy.modules.txt",
    "hash:stamp": "pnpm hash:build && node packages/hashy/dist/cli.js",
    "clean:modules": "bash clean-modules.sh",
    "clean:install": "bash clean-install.sh"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        2,
        "always",
        1000
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "24.16.0"
  }
}
