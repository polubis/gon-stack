{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalEnv": [
    "CI",
    "PUBLIC_SUPABASE_URL",
    "PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "AUTH_CALLBACK_URL",
    "PUBLIC_PARKA_SUPABASE_URL",
    "PUBLIC_PARKA_SUPABASE_PUBLISHABLE_KEY"
  ],
  "tasks": {
    "//#format:check": {
      "inputs": [
        "**/*.{ts,tsx,json,yaml,css,js,jsx}",
        ".prettierrc*",
        ".prettierignore",
        "!**/node_modules/**"
      ]
    },
    "//#nitpick:check": {
      "dependsOn": ["@repo/nitpick#build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true
    },
    "test:e2e:headed": {},
    "test:e2e:report": {},
    "test:e2e:update-snapshots": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "db:gen-types": {
      "cache": false
    }
  }
}
